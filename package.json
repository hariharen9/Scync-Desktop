{
  "name": "scync-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Scync Desktop — zero-knowledge secrets manager for macOS and Windows",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "build:win": "node scripts/build-windows.mjs",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-google-client": "node scripts/generate-google-client.mjs"
  },
  "dependencies": {
    "firebase": "10.14.1",
    "node-forge": "^1.3.1",
    "otpauth": "9.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "5.5.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node-forge": "^1.3.11",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.6.3",
    "vite": "6.3.7",
    "vitest": "2.1.9"
  }
}
