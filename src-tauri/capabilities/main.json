{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main window: owns the vault key. Gets the app commands (OAuth, clipboard, settings, window, autostart) and event APIs.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:event:default"
  ]
}
